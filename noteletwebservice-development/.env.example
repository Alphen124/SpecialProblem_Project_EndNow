# Environment Variables Configuration
# Copy this file to .env and update the values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=notelet

# JWT Secret Keys (Change these in production!)
JWT_ACCESS_SECRET=your-access-token-secret-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-key-change-this-in-production

# JWT Token Expiry (in hours)
JWT_ACCESS_EXPIRY=24
JWT_REFRESH_EXPIRY=168

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# Allowed Email Domain
ALLOWED_EMAIL_DOMAIN=@kmitl.ac.th

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
